[Unit]
Description=Mini-GitHub API
After=network.target postgresql.service

[Service]
Type=exec
User=minigithub
WorkingDirectory=/opt/mini-github
EnvironmentFile=/opt/mini-github/.env.production
ExecStart=/opt/mini-github/venv/bin/gunicorn main:app \
    --worker-class uvicorn.workers.UvicornWorker \
    --workers 4 \
    --bind 0.0.0.0:8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
